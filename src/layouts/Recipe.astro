---
import Layout from "./Layout.astro";
import { Icon } from "astro-icon/components";
interface Content {
    name: string;
    ingredients: string[];
    time?: number /* in minutes */;
    description?: string;
    image?: string;
    tags: string[];
    portions?: number;
    portion_type?: string;
}

interface Props {
    content: Content;
}

let {
    name,
    tags,
    ingredients,
    time,
    description,
    image,
    portion_type, // @ts-ignore
} = Astro.props["content"] as Content;

// @ts-ignore
let { portions } = Astro.props["content"] as Content;

const type_plurals: any = {
    kus: ["kusy", "kusů"],
    lžíce: ["lžíce", "lžic"],
    lžička: ["lžičky", "lžiček"],
    hrnek: ["hrnky", "hrnků"],
    sklenice: ["sklenice", "sklenic"],
    porce: ["porce", "porcí"],
    hrnec: ["hrnce", "hrnců"],
    "bochník": ["bochníky", "bochníků"],
};

function pluralize(n: number, type: string): string {
    if (!type_plurals[type]) {
        return type;
    }
    if (n === 1) {
        return type;
    }
    if (n < 5) {
        return type_plurals[type][0];
    }
    return type_plurals[type][1];
}
---

<Layout title={name} description={description ? description : ""} overwriteTitle image={image}>
    <main class="basic-info">
        <div class="recipe">
            <div class="recipe-body">
                <slot />
            </div>
            {image && image.length > 0 ? <img src={image} alt={name} /> : undefined}
        </div>

        <div class="ingredients">
            <div class="recipe-info">
                {time && (
                        <span
                        ><Icon name="ic:baseline-access-time" /> Čas: {time} minut</span
                        >
                )}
            </div>
            <h3>Ingredience</h3>
            {portions && portion_type && (
                    <div class="portion-tool">
                        na
                        <div class="portions">
                            <button id="dec"
                            ><Icon name="ic:baseline-keyboard-arrow-down" /></button
                            >
                            <input
                                    type="number"
                                    id="count"
                                    value={portions}
                                    autocomplete="off"
                            />
                            <button id="inc"
                            ><Icon name="ic:baseline-keyboard-arrow-up" /></button
                            >
                        </div>
                        <span id="portion_type"
                        >{pluralize(portions, portion_type)}</span
                        >
                    </div>
            )}
            <ul id="ingredients">
                {
                    ingredients.map((ingredient) => (
                        <li>
                            <input
                                type="checkbox"
                                id={ingredient}
                                name={ingredient}
                            />
                            <label for={ingredient}>{ingredient}</label>
                        </li>
                    ))
                }
            </ul>
            <div class="keywords">
                <h3>Klíčová slova</h3>
                <div class="tags">
                    {tags.map((tag) => <div class="tag"><a href={`/tag/${tag}`}>{tag}</a></div>)}
                </div>
            </div>
            <h3 class="postup-header">
                Postup
            </h3>
        </div>
    </main>
</Layout>

<style>
    .basic-info {
        display: flex;
        flex-direction: row;
        background-color: var(--gray);
    }

    .ingredients {
        margin: 20px;
        padding: 2em;
        border-radius: 12px;
        background-color: var(--background-color);
    }

    .recipe {
        display: flex;
        flex-direction: column;
        margin: 20px;
        background-color: var(--background-color);
        padding: 2em;
        flex: 1;
        border-radius: 12px;
    }

    .recipe-info {
        display: flex;
        justify-content: space-between;
        margin: 10px 0;
        width: 300px;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        margin: 10px 0;
    }

    .tag {
        background-color: #f0f0f0;
        border-radius: 5px;
        padding: 5px 10px;
        margin: 5px;
    }

    .tag a {
        text-decoration: none;
        color: inherit;
    }

    img {
        max-width: 100%;
        height: auto;
        max-height: 400px;
        border-radius: 10px;
        margin: 20px 0;
    }

    ul {
        list-style-type: none;
        padding: 0;
    }

    li {
        display: flex;
        align-items: center;
        margin: 5px 0;
    }

    input[type="checkbox"] {
        margin-right: 10px;
    }

    input[type="number"] {
        width: 20px;
        margin-right: 10px;
        padding: 12px;
        -moz-appearance: textfield;
        outline: none;
        margin: 0;
        border: unset;
        outline: unset;
    }
    .portion-tool {
        display: flex;
        align-items: center;
        margin-bottom: 10px;
    }
    button {
        border: unset;
        outline: unset;
        padding: 10px;
        border-radius: 5px;
        cursor: pointer;
        background-color: white;
        color: var(--text-color);
    }

    .portions {
        display: inline-flex;
        flex-direction: row;
        border: 1px solid white;
        border-radius: 12px;
        background-color: white;
        margin-left: 10px;
        margin-right: 10px;
    }

    /* Hide the number increment decrement decoration */
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .postup-header {
        display: none;
    }

    @media screen and (max-width: 600px) {
        .basic-info {
            flex-direction: column-reverse;
        }

        .recipe, .ingredients {
            margin: 10px;
        }

        .recipe {
            margin-top: -50px;
            border-top-right-radius: 0;
            border-top-left-radius: 0;
        }

        .ingredients {
            padding-bottom: 0;
            margin-bottom: 0;
            border-bottom-left-radius: 0;
            border-bottom-right-radius: 0;
        }

        .postup-header {
            display: inherit;
        }

        .keywords {
            visibility: hidden;
            height: 0;
        }

        img {
            max-height: 200px;
        }
    }

    @media print {
        .basic-info {
            flex-direction: column-reverse;
        }

        input {
            border: none;
        }

        #dec, #inc {
            display: none;
        }

        .portion-tool {
            padding-bottom: 0;
            padding-top: 3px;
        }

        #count, #ingredients {
            border: none;
            padding: 0;
        }

        :global(.nav, .book, footer) {
            display: none;
        }

        :global(.container) {
            padding: 0 !important;
            margin: 0 !important;
        }

        :global(h1) {
            font-size: 40px !important;
        }

        .recipe, .ingredients{
            margin: 10px;
        }

        .recipe {
            margin: 0;
            border: none;
            padding: 0;
        }

        .ingredients {
            margin: 0;
            padding: 0;
        }

        .postup-header {
            display: inherit;
        }

        .keywords {
            visibility: hidden;
            height: 0;
        }

        img {
            max-height: 200px;
        }
    }
</style>

<script>
    const type_plurals: any = {
        kus: ["kusy", "kusů"],
        lžíce: ["lžíce", "lžic"],
        lžička: ["lžičky", "lžiček"],
        hrnek: ["hrnky", "hrnků"],
        sklenice: ["sklenice", "sklenic"],
        porce: ["porce", "porcí"],
        hrnec: ["hrnce", "hrnců"],
        "bochník": ["bochníky", "bochníků"],
    };

    function pluralize(n: number, type: string): string {
        if (n === 1) {
            return type;
        }
        if (n < 5) {
            return type_plurals[type][0];
        }
        return type_plurals[type][1];
    }

    const inc = document.getElementById("inc");
    const dec = document.getElementById("dec");
    const input = document.querySelector("#count");
    const originalCount = parseInt((input as HTMLInputElement).value);
    const portionType = document.querySelector("#portion_type");
    const originalPortionType = (portionType as HTMLElement).innerText;

    inc?.addEventListener("click", () => {
        if (input) {
            (input as HTMLInputElement).value = (
                parseInt((input as HTMLInputElement).value) + 1
            ).toString();
            // invoke input event to update the portion type
            const event = new Event("input");
            input?.dispatchEvent(event);
        }
    });

    dec?.addEventListener("click", () => {
        if (input && parseInt((input as HTMLInputElement).value) > 1) {
            (input as HTMLInputElement).value = (
                parseInt((input as HTMLInputElement).value) - 1
            ).toString();
            // invoke input event to update the portion type
            const event = new Event("input");
            input?.dispatchEvent(event);
        }
    });

    const ingredients = document.querySelector("#ingredients");
    // original list, only the current innerText of each li
    const originalList: string[] = [];
    ingredients?.querySelectorAll("li").forEach((li) => {
        originalList.push(li.innerText);
    });

    function updateIngredients(multiplier: number) {
        if (!originalList.length) {
            return;
        }
        // Detect numbers in the ingredients innerText (li) and multiply them
        ingredients?.querySelectorAll("label").forEach((li, index) => {
            const originalText = originalList[index];
            if (!originalText) {
                return;
            }
            const matches = originalText.match(/\d+/g);
            if (matches) {
                let newText = originalText;
                matches.forEach((match) => {
                    let newNumber:any = parseInt(match) * (multiplier / originalCount);
                    if (newNumber % 1 !== 0) {
                        newNumber = newNumber.toFixed(2);
                    }
                    newText = newText.replace(match, newNumber.toString());
                });
                li.innerText = newText;
            }
        });
    }

    input?.addEventListener("input", () => {
        let strVal = (input as HTMLInputElement).value;
        if (strVal === "") {
            strVal = "1";
        }
        let val = parseInt(strVal);
        if (input && val < 1) {
            val = 1;
            (input as HTMLInputElement).value = "1";
        }
        updateIngredients(val);
        (portionType as HTMLElement).innerText = pluralize(
            val,
            originalPortionType,
        );
    });
</script>
