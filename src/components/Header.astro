---
import { Image } from "astro:assets";
import Book from "../resources/book.svg";

interface Props {
    title?: string;
    description?: string;
}

let title = Astro.props.title || "Maminčina kuchařka";
let description = Astro.props.description || "To nejlepší z rodinné kuchařky";

let pathName = Astro.url.pathname;

let paths: Record<string, string> = {
    "/": "Domů",
    "/polevky": "Polévky",
    "/hlavni-jidla": "Hlavní jídla",
};

if (!paths[pathName]) {
    paths[pathName] = title;
}
---

<header>
    <div class="container">
        <div class="nav">
            <nav>
                <ul>
                    {Object.entries(paths).map(([path, name]) => (
                        <li>
                            <a
                                href={path}
                                class={pathName === path ? "current" : ""}
                                >{name}</a
                            >
                        </li>
                    ))}
                </ul>
            </nav>
        </div>
        <div class="title">
            <h1>{title}</h1>
            <p>{description}</p>
        </div>
    </div>
    <Image class="book" src={Book} alt="Maminčina kuchařka" />
</header>

<style>
    header {
        background-color: var(--pink-light);
        margin: 0;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        transition:
            background-color 0.3s ease,
            height 0.3s ease; /* Added transition */
    }

    .container {
        padding: 3em;
        display: flex;
        justify-content: space-between;
        flex-direction: column;
        transition: padding 0.3s ease; /* Added transition */
    }

    .book {
        width: 200px;
        height: auto;
        margin-right: 3em;
        transition: margin-right 0.3s ease; /* Added transition */
    }

    h1 {
        font-size: 4em;
        margin: 0;
        transition: font-size 0.3s ease; /* Added transition */
    }

    ul {
        list-style: none;
        padding: 0;
    }

    li {
        display: inline;
        margin-right: 1em;
    }

    a {
        text-decoration: none;
        color: var(--gray);
        font-size: 1.2em;
    }

    a:hover {
        text-decoration: underline;
    }

    a:visited {
        color: var(--gray);
    }

    a.current {
        color: var(--text-color);
        font-weight: 500;
        text-decoration: underline;
    }

    @media screen and (max-width: 700px) {
        .container {
            padding: 1em;
        }

        h1 {
            font-size: 2em;
        }

        .book {
            width: 100px;
            margin-right: 1em;
        }

        a {
            font-size: 1.2em;
            padding-top: 10px;
        }
    }

    header.scroll {
        position: sticky;
        top: 0;
        z-index: 1000;
        flex-direction: row-reverse;
        justify-content: left;
        vertical-align: middle;
    }

    .scroll .container {
        flex-direction: row-reverse;
        padding: 0; /* Remove padding on scroll */
        flex: 1;
    }

    .scroll .title {
        display: flex;
        align-items: center;
    }

    .scroll h1 {
        font-size: 1.5em; /* Change font size on scroll */
        margin: 0;
    }

    .scroll .book {
        margin-right: 1em;
        height: 3em;
        width: auto;
    }

    .scroll p {
        display: none;
    }

    .scroll nav {
        float: right;
    }

    @media screen and (max-width: 550px) {
        .scroll h1 {
            display: none;
        }
    }
</style>

<script>
    const header = document.querySelector("header");
    const originalHeaderHeight = header ? header.offsetHeight : 0;
    window.addEventListener("scroll", () => {
        if (!header) return;
        if (window.scrollY > originalHeaderHeight + 56 * 2) {
            header.classList.add("scroll");
        } else if (window.scrollY < 56) {
            header.classList.remove("scroll");
        }
    });
</script>
