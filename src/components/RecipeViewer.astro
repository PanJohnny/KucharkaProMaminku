---
import {getCollection} from "astro:content";
import RecipeLink from "./RecipeLink.astro";

let recipes = await getCollection("recipes");

interface Props {
    editMode?: boolean;
    tagged?: string;
}

const { editMode, tagged } = Astro.props as Props;

if (tagged) {
    recipes = recipes.filter((recipe) =>
        recipe.data.tags?.includes(tagged)
    );
}

---


<section id="recipes">
    {
        recipes
            .slice(0, 20)
            .map((recipe) => (
                    <RecipeLink
                            title={recipe.data.name}
                            description={recipe.data.description}
                            image={recipe.data.image}
                            link={"/recept/" + recipe.id || "/404"}
                            time={recipe.data.time}
                            editMode={editMode}
                    />
            ))
    }
</section>

<style>
    section {
        padding: 1.5rem 3rem 1.5rem 3rem;
    }

    #recipes {
        background-color: var(--gray);
    }

    @media screen and (max-width: 600px) {
        section {
            padding: 1em;
        }
    }
</style>