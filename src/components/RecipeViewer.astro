---
import Recipe from "../components/Recipe.astro";

let recipes = await Astro.glob("../pages/recept/*.md");

interface Props {
    editMode?: boolean;
    tagged?: string;
}

const { editMode, tagged } = Astro.props as Props;

if (tagged) {
    recipes = recipes.filter((recipe) =>
        recipe.frontmatter.tags?.includes(tagged)
    );
}
---


<section id="recipes">
    {
        recipes
            .slice(0, 20)
            .map((recipe) => (
                    <Recipe
                            title={recipe.frontmatter.name}
                            description={recipe.frontmatter.description}
                            image={recipe.frontmatter.image}
                            link={recipe.url || "/404"}
                            time={recipe.frontmatter.time}
                            editMode={editMode}
                    />
            ))
    }
</section>

<style>
    section {
        padding: 1.5rem 3rem 1.5rem 3rem;
    }

    #recipes {
        background-color: var(--gray);
    }

    @media screen and (max-width: 600px) {
        section {
            padding: 1em;
        }
    }
</style>