---
import { Icon } from 'astro-icon/components'

interface Props {
	title: string;
	time: string;
	difficulty: string;
	description: string;
	image: string;
	link: string;
	editMode?: boolean;
}

const { title, time, difficulty, description, image, link, editMode } = Astro.props as Props;

let finalLink = editMode ? "/admin/edit?r=" + encodeURIComponent(link) : link;
---
<a href={finalLink} data-recipe>
	<div class="recipe">
		<div class="recipe-body">
			<h2 data-pl="title">{title}</h2>
            {time || difficulty ? (
			<div class="recipe-info">
                {time && <span data-pl="time"><Icon name="ic:baseline-access-time"/> Čas: {time} minut</span>}
                {difficulty && <span data-pl="difficulty"><Icon name="ic:outline-workspace-premium" /> Obtížnost: {difficulty}/5</span>}
			</div>
                ):undefined}
            {description && (<p data-pl="description">
                {description}
            </p>)}
		</div>
		{image.length > 0? <img src={image} alt={title} data-pl="image" /> :undefined}
	</div>
</a>

<style>
    .recipe {
		background-color: var(--background-color);
		display: flex;
		border-radius: 12px;
		overflow: hidden;
		width: 100%;
		margin-bottom: 1em;
		flex-direction: row-reverse;
		height: 180px;
		cursor: pointer;
	}

	.recipe h2 {
		margin-bottom: 5px;
	}

	.recipe-info {
		margin-bottom: 1em;
	}

	.recipe-body {
		padding: 1em;
		flex: 1;
	}

	.recipe img {
		height: auto;
		width: 30vw;
		object-fit: cover;
	}

	@media screen and (max-width: 600px) {
        .recipe:not(:has(> img)) {
            height: auto;
        }

		.recipe {
			flex-direction: column-reverse;
			height: 400px;
		}

		.recipe img {
			width: 100%;
		}
	}

	[data-icon] {
		vertical-align: text-top;
		font-size: 1.2em;
	}

    a {
        all: unset;
    }
</style>

<style is:global>
	[data-recipe]:nth-of-type(even) .recipe {
		flex-direction: row;
    }

    @media screen and (max-width: 600px) {
		[data-recipe]:nth-of-type(even) .recipe {
			flex-direction: column-reverse;
		}
    }
</style>