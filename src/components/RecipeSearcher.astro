---
import Recipe from "../components/Recipe.astro";

const recipes = await Astro.glob("../pages/recept/*.md");

interface Props {
    editMode?: boolean;
}

const { editMode } = Astro.props as Props;
---

<div>
    <div class="inputs">
        <h2>Vyhledejte recept</h2>
        <p>Při vyhledávání můžete používat názvy, klíčová slova, ingredience a popisy receptů.</p>
        <input
            type="search"
            name="recept"
            id="search"
            placeholder="Hledejte recept"
        />
        <input type="button" value="Vyhledat" id="submit">
    </div>
</div>

<style>
    @media screen and (max-width: 600px) {
        section {
            padding: 1em;
        }
    }

    input {
        padding: 12px;
        -moz-appearance: textfield;
        outline: none;
        margin: 0;
        border: unset;
        outline: unset;
        border-radius: 12px;
    }

    input::-webkit-inner-spin-button,
    input::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .inputs {
        background-color: var(--background-color);
        padding: 2em;
        margin-bottom: 2em;
        border-radius: 12px;
    }
</style>