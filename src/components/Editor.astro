---
interface Props {
    frontmatter?: any;
    body?: string;
    link?: string;
}
const { frontmatter, body, link } = Astro.props as Props;

function f(s: string) {
    if (frontmatter && frontmatter[s]) {
        return frontmatter[s];
    }
}

const localMode = Astro.url.hostname == "localhost" || Astro.url.hostname == "127.0.0.1";
---

<div class="editor">
    <div class="info">
        {link
            ? `Úprava receptu: ${link}`
            : "Vytváříte nový recept, po odeslání bude dostupný na /recept/nazev-receptu"}
        {localMode
            ? " (Lokální režim)"
            : ""}
    </div>
    <input type="button" value="Otevřít aktualizující se ukázku" id="sim" />
    <input
        type="text"
        name="name"
        id="name"
        placeholder="Název"
        value={f("name")}
        class="title"
    />
    <label for="description">Popis:</label>
    <input
        type="text"
        name="description"
        id="description"
        placeholder="Popis"
        value={f("description")}
    />
    <label for="image">URL obrázku:</label>
    <input
        type="url"
        name="image"
        id="image"
        placeholder="Odkaz na obrázek"
        value={f("image")}
    />
    <label for="time">Čas přípravy:</label>
    <div class="line">
        <input
            type="number"
            name="time"
            id="time"
            placeholder="Čas přípravy"
            value={f("time")}
        />
        <b>min</b>
    </div>
    <label for="tags">Klíčová slova (oddělujte čárkou):</label>
    <input
        type="text"
        name="tags"
        id="tags"
        placeholder="Oddělujte čárkou"
        value={f("tags")}
    />
    <label for="count">Počet procí a typ porce</label>
    <div class="line">
        <input
            type="number"
            name="count"
            id="count"
            placeholder="Počet porcí"
            value={f("portions")}
        />
        <input
            type="text"
            name="portion_type"
            id="portion_type"
            placeholder="kus/porce/..."
            value={f("portion_type")}
        />
    </div>
    <label for="body">Text:</label>
    <textarea
        name="body"
        id="body"
        placeholder="Sem napište poznatky o jídle a postup">{body}</textarea
    >
    <label for="ingredients">Ingredience:</label>
    <textarea
        name="ingredients"
        id="ingredients"
        placeholder="Jednotlivé ingredience oddělujte novými řádky"
        >{f("ingredients")?f("ingredients").map((ing: string) => ing + "\n"):undefined}</textarea
    >
    <p>
        Text postupu využívá formátování markdownu, návod <a
            href="https://www.markdownguide.org/basic-syntax/">zde</a
        >.
    </p>
    <input type="button" value="Odeslat změny" id="submit" />
</div>

<style>
    .editor {
        display: flex;
        flex-direction: column;
        gap: 1em;
        font-family: "Inter", sans-serif;
    }

    .editor input[type="button"] {
        background-color: yellow;
        color: var(--text-color);
        border: unset;
        border-radius: 12px;
        padding: 0.5em 1em;
        cursor: pointer;
    }

    #submit {
        background-color: chocolate;
        color: white;
    }

    .editor input,
    .editor textarea {
        border: 1px solid var(--gray);
        border-radius: 12px;
        padding: 0.5em;
        font-family: inherit;
        font-size: 1em;
        color: var(--text-color);
        background-color: white;
    }

    .editor input.title {
        font-size: 2em;
        font-weight: 900;
    }

    .editor label {
        font-weight: 500;
        color: var(--text-color);
    }

    .editor textarea {
        resize: vertical;
        height: 250px;
        min-height: 100px;
    }

    .line {
        display: flex;
        gap: 1em;
        align-items: center;
        flex-wrap: wrap;
    }

    .line :first-child {
        flex: 1;
    }

    .info {
        background-color: #53c2ea;
        padding: 0.5em 1em;
        border-radius: 12px;
        font-size: 1.2em;
        color: var(--text-color);
    }
</style>

<script define:vars={{link, localMode}}>
    const name = document.getElementById("name") ;
    const description = document.getElementById(
        "description",
    );
    const image = document.getElementById("image") ;
    const time = document.getElementById("time") ;
    const ingredients = document.getElementById(
        "ingredients",
    );
    const body = document.getElementById("body");
    const tags = document.getElementById("tags");
    const count = document.getElementById("count");
    const portionType = document.getElementById(
        "portion_type",
    ) ;

    const sim = document.getElementById("sim") ;

    let win = null;
    sim.addEventListener("click", () => {
        // open /admin/sim as popup, keep the window object to update it using sendMessage
        win = window.open("/admin/sim", "sim", "width=400,height=400");
        // send the current recipe to the popup
        if (win) win.onload = sync;
    });

    const elements = [
        name,
        description,
        image,
        time,
        ingredients,
        body,
        tags,
        count,
        portionType,
    ];

    elements.forEach((element) => {
        element.addEventListener("input", sync);
    });

    function sync() {
        win?.postMessage(
            {
                frontmatter: {
                    name: name?.value,
                    description: description?.value,
                    image: image?.value,
                    time: time?.value,
                    ingredients: ingredients?.value
                        .split("\n")
                        .filter((ing) => ing.trim() !== ""),
                    tags: tags?.value
                        .split(",")
                        .map((tag) => tag.trim()),
                    portions: count?.value,
                    portion_type: portionType?.value,
                },
                body: body?.value,
            },
            "*",
        );
    }

    const submit = document.getElementById("submit") ;

    submit.addEventListener("click", async () => {
        const recipeLink = link ? link.split("/").pop()?.replace(".md", "") : name.value.toLowerCase().normalize('NFKD').replace(/\s+/g, "-").replace(/[^\w-]/g, '');
        const data = {
            recept: recipeLink,
            raw: `---
layout: "../../layouts/Recipe.astro"
name: "${name.value}"
description: "${description.value}"
tags: ${JSON.stringify(tags.value.split(",").map((tag) => tag.trim()))}
time: ${time.value}
portions: ${count.value}
portion_type: "${portionType.value}"
image: "${image.value}"
ingredients: ${JSON.stringify(ingredients.value.split("\n").filter((ing) => ing.trim() !== ""))}
---

${body.value}
    `,
        };

        // Create a dialog popup that will show the data, to double check
        const dialog = document.createElement("dialog");
        dialog.innerHTML = `<h2>Udělejte poslední kontrolu</h2>\n<pre>${data.raw}</pre>
    <button id='ok'>OK</button> <button id='cancel'>Zrušit</button>`;
        document.body.appendChild(dialog);
        dialog.showModal();

        const ok = document.getElementById("ok");
        const cancel = document.getElementById("cancel");

        ok.addEventListener("click", async () => {
            dialog.close();
            dialog.remove();
            try {
                const response = await fetch(localMode?"/admin/write":"/admin/commit", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                    },
                    body: JSON.stringify(data),
                });

                if (response.ok) {
                    alert("Změny byly úspěšně odeslány!");
                } else {
                    alert("Nastala chyba při odesílání změn.");
                }
            } catch (error) {
                alert("Nastala chyba při odesílání změn.");
            }
        });

        cancel.addEventListener("click", () => {
            dialog.close();
            dialog.remove();
            alert("Změny nebyly odeslány.");
        });
    });
</script>

<style is:inline>
    dialog {
        background-color: white;
        padding: 1em;
        border-radius: 12px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        z-index: 1000;
        max-width: 90vw !important;
    }

    dialog button {
        background-color: yellow;
        color: var(--text-color);
        border: unset;
        border-radius: 12px;
        padding: 0.5em 1em;
        cursor: pointer;
    }
</style>
