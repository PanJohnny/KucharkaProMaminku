---
import Editor from "../../components/Editor.astro";
import Layout from "../../layouts/Layout.astro";
import {getEntry} from "astro:content";
export const prerender = false;

if (!Astro.cookies.has("github_token")) {
    return Astro.rewrite("/admin/login");
}

const r = Astro.url.searchParams.get("r");
let recipe:any;
if (r) {
    if (!r.startsWith("/recept/") || r.includes("..")) {
        return Astro.redirect("/ne");
    }

    recipe = {...await getEntry("recipes", r.replace("/recept/", "")), url: r};

    if (!recipe) {
        return Astro.redirect("/admin/");
    }
}
---

<Layout title="Administrace" description="Správa receptů">
    <main>
        <div class="float">
            <Editor
                frontmatter={recipe?.data}
                body={recipe?.body}
                link={recipe?.url}
            />
        </div>
    </main>
</Layout>

<style>
    main {
        background-color: var(--gray);
        padding: 2em;
    }

    .float {
        display: flex;
        flex-direction: column;
        background-color: var(--background-color);
        padding: 2em;
        border-radius: 12px;
        margin-bottom: 2em;
    }
</style>
