---
import Layout from "../layouts/Layout.astro";
import RecipeLink from "../components/RecipeLink.astro";
---

<Layout
	title="Oranžová kuchařka"
	description="To nejlepší z rodinné kuchařky"
>
	<main>
		<section id="recipes">
            <RecipeLink description="Tradiční, od babičky i exotika" image="" link="/polevky" time="" title="Polévky"/>
            <RecipeLink description="Tradiční, od babičky i exotika" image="" link="/" time="" title="Přílohy a sváči"/>
            <RecipeLink description="Tradiční, od babičky i exotika" image="" link="/hlavni-jidla" time="" title="Hlavní jídla"/>
            <RecipeLink description="Tradiční, od babičky i exotika" image="" link="/" time="" title="Slavíme"/>
            <RecipeLink description="Tradiční, od babičky i exotika" image="" link="/" time="" title="Mňam"/>
        </section>
	</main>
</Layout>

<style>
    section {
        padding: 1.5rem 3rem 1.5rem 3rem;
    }

	#recipes {
		background-color: var(--gray);
	}

	@media screen and (max-width: 600px) {
		section {
			padding: 1em;
		}
	}
</style>
