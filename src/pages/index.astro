---
import Layout from "../layouts/Layout.astro";
import Recipe from "../components/Recipe.astro";

const recipes = await Astro.glob('./recept/*.md');
---

<Layout
	title="Maminčina kuchařka"
	description="To nejlepší z rodinné kuchařky"
>
	<main>
		<section id="recipes">
			{recipes.map(recipe => (
				<Recipe 
					title={recipe.frontmatter.name} 
					description={recipe.frontmatter.description} 
					difficulty={recipe.frontmatter.difficulty} 
					image={recipe.frontmatter.image} 
					link={recipe.url || "/404"} 
					time={recipe.frontmatter.time} 
				/>
			))}
		</section>
	</main>
</Layout>

<style>
	section {
		padding: 3em;
	}

	#recipes {
		background-color: var(--gray);
	}

	@media screen and (max-width: 600px) {
		section {
			padding: 1em;
		}
	}
</style>
